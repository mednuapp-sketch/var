<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MedNu Service</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mednu_doctor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Contacts permission for SOS emergency contacts -->
	<key>NSContactsUsageDescription</key>
	<string>MedNu Service needs access to your contacts so you can select emergency contacts for SOS alerts.</string>
	<!-- Camera & Microphone for video consultations -->
	<key>NSCameraUsageDescription</key>
	<string>MedNu Service uses the camera for video consultations and profile photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>MedNu Service uses the microphone so you can speak with patients during video consultations.</string>
	<!-- Photos / Files -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MedNu Service accesses your photo library to upload profile photos and medical documents.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MedNu Service saves prescriptions and reports to your photo library.</string>
	<!-- Location permissions for doctor GPS tracking -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>MedNu Service uses your GPS location to show you to patients within 10 km. Location must be ON while you are online.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>MedNu Service uses your GPS location to show you to patients within 10 km. Location must be ON while you are online.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>MedNu Service uses your GPS location to show you to patients within 10 km.</string>
</dict>
</plist>
