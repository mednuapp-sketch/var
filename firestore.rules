rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    // Check if the requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if the requesting user owns the document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Check if user is an admin (admins are stored in the 'admins' collection)
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admin profile/role (mednu-admin panel access control) ────────────────
    // Mirrors ROLE_TAB_ACCESS in mednu-admin/js/app.js — keep both in sync.
    // An admins/{uid} doc with no `role` field is treated as 'director' (full
    // access), matching the client's verifyAdminRole() default.
    function adminRole() {
      return isAdmin() ?
        (('role' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) ?
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role : 'director')
        : null;
    }
    // Directors always pass any adminInRoles() check, regardless of the list given.
    function isDirector() { return adminRole() == 'director'; }
    function adminInRoles(roles) { return isAdmin() && (isDirector() || adminRole() in roles); }

    // Check if user is a verified doctor
    function isDoctor() {
      return isAuth() &&
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }

    // Check if user has an approved Lab & Diagnostics partner profile.
    // Requires `status == 'active'`, not mere existence of the profile doc —
    // every call site below is "may this account see/claim an UNCLAIMED
    // booking", and an admin-unapproved ('pending') registration must not
    // be able to touch real patient bookings just because it self-created a
    // profile doc (the `create` rule lets any authenticated user do that;
    // approval is what's supposed to gate real access).
    function isLabPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/lab_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/lab_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has an approved Pharmacy & Medical Equipment partner
    // profile. See isLabPartner() above for why `status == 'active'` is
    // required rather than mere existence.
    function isPharmacyPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/pharmacy_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/pharmacy_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has an approved Ambulance partner profile. See
    // isLabPartner() above for why `status == 'active'` is required rather
    // than mere existence.
    function isAmbulancePartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/ambulance_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ambulance_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has an approved Caregiver partner profile. See
    // isLabPartner() above for why `status == 'active'` is required rather
    // than mere existence.
    function isCaregiverPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/caregiver_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/caregiver_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has an approved Physiotherapy partner profile — same
    // active-status gate as isLabPartner() and friends above.
    function isPhysiotherapistPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/physiotherapist_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/physiotherapist_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has a Counselling partner profile. See
    // isPhysiotherapistPartner() above for why this checks `status ==
    // 'active'` rather than mere existence.
    function isCounsellorPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/counsellor_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/counsellor_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Check if user has an approved Hospital billing-desk partner profile —
    // same active-status gate as isLabPartner() and friends above.
    function isHospitalPartner() {
      return isAuth() &&
        exists(/databases/$(database)/documents/hospital_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hospital_profiles/$(request.auth.uid)).data.status == 'active';
    }

    // Same as isHospitalPartner() but also pins the check to a specific
    // hospitals/{hospitalId} catalog entry — a billing-desk login is not
    // itself the earning entity (see hospital_profiles below), so any rule
    // scoping a doc by `hospitalId` (bill payments, OP appointments,
    // provider_wallets/wallet_ledger keyed by hospitalId) needs this instead
    // of a bare isOwner()/isHospitalPartner() check.
    function isHospitalPartnerFor(hospitalId) {
      return isHospitalPartner() &&
        get(/databases/$(database)/documents/hospital_profiles/$(request.auth.uid)).data.hospitalId == hospitalId;
    }

    // Validate that a write doesn't modify protected fields
    function doesNotModify(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── Admins collection ───────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      // Only Firebase Console / Cloud Functions can manage admin accounts — the
      // one narrow exception is an admin registering their own browser-push
      // token for the live notification bell (see initAdminPushNotifications,
      // mednu-admin/js/app.js, and _sendAdminAlert/_pushToAllAdmins in
      // functions/index.js, which read this field to target every admin).
      // `role` and everything else stays locked down — this can never be used
      // to self-promote or touch another admin's doc.
      allow update: if isOwner(adminId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt']);
      allow create, delete: if false;
    }

    // ── Admin-generated reports (mednu-admin Reports tab) ────────────────────
    // Separate from the patient-app 'reports' collection (uploaded scans) —
    // see the comment in mednu-admin/js/app.js's loadReportsList(). Had no
    // rule at all until now, so the Reports tab 404'd with permission-denied
    // for every admin, including Directors.
    match /admin_generated_reports/{reportId} {
      allow read, write: if adminInRoles(['support', 'hr']);
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read/update their own profile; admins can read all
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // walletBalance, mednuMoneyBalance and referralPoints are MONEY — they are
      // written exclusively by Cloud Functions via the Admin SDK (which bypasses
      // these rules). No client write, legitimate or otherwise, may touch them.
      // role and createdAt remain protected for the same reason.
      allow update: if isOwner(userId) &&
                       doesNotModify(['role', 'createdAt',
                                      'walletBalance', 'mednuMoneyBalance', 'referralPoints']);
      allow delete: if false; // Account deletion handled by Cloud Functions only

      // Wallet transactions — user reads own; entries are written server-side only,
      // in the same transaction as the balance update that produced them.
      match /transactions/{txId} {
        allow read:   if isOwner(userId) || isAdmin();
        allow create: if isAdmin();       // Cloud Functions (Admin SDK) / admin console only
        allow update, delete: if false;   // Transactions are immutable once created
      }

      // Refund records — read-only to the user (My Refunds screen); the
      // refund ledger itself is written server-side only, never by a client.
      match /refunds/{refundId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Family members — user manages their own
      match /family_members/{memberId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Patient notifications ───────────────────────────────────────────────
    match /patient_notifications/{userId}/items/{notifId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // Any authenticated user may CREATE a notification for another user.
      // This is required so the referral service can notify the referrer when
      // a reward is credited from a different user's context.
      allow create: if isAuth();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Doctors ─────────────────────────────────────────────────────────────
    match /doctors/{doctorId} {
      // Any authenticated user can browse active (approved) doctors
      allow read: if isAuth() && (
        resource.data.status == 'active' || isOwner(doctorId) || isAdmin()
      );
      // Doctors update their own profile (limited fields); admins can update all.
      // rating/totalReviews/totalConsultations are aggregates: Cloud-Function-only
      // (Admin SDK bypasses rules), exactly like the *_transactions ledgers. No
      // client — owner or otherwise — may write them, which closes the review
      // forgery path where any signed-in user could set an arbitrary rating.
      // A self-registering account (isOwner path) must start 'pending' —
      // without this, any authenticated user could `set()` their own
      // doctors/{uid} with `status: 'active'` and appear as an approved,
      // publicly bookable doctor with zero admin review (the read rule
      // above gates public visibility on `status` alone). Also blocks
      // self-writing 'admin' into `roles`: real admin status is decided
      // solely by the separate, client-unwritable `admins` collection
      // (see isAdmin()), so this doesn't grant any actual Firestore
      // privilege today — but `roles` is also what the app's own UI role
      // engine reads (shared_core/models/app_role.dart), so leaving this
      // open would let an account label/route itself as "Admin" in-app and
      // become a live landmine the moment any admin feature module starts
      // trusting that role for something real. rating/totalReviews/
      // totalConsultations are pinned to their zero defaults too, for the
      // same reason as the *_profiles collections below: the update rule
      // already blocks the owner from changing them later, so a fake value
      // set at creation would otherwise survive forever, including past
      // legitimate admin approval to 'active' (i.e. becoming a publicly
      // visible fake rating). Both real registration flows
      // (DoctorAuthService.registerDoctor, PartnerRoleRegisterScreen)
      // already always write status: 'pending', ratings at 0, and never
      // write 'admin' into roles, so this matches existing behaviour
      // rather than changing it.
      allow create: if isAdmin() ||
                       (isOwner(doctorId) &&
                        request.resource.data.status == 'pending' &&
                        (!('roles' in request.resource.data) ||
                         !('admin' in request.resource.data.roles)) &&
                        (!('rating' in request.resource.data) || request.resource.data.rating == 0) &&
                        (!('totalReviews' in request.resource.data) || request.resource.data.totalReviews == 0) &&
                        (!('totalConsultations' in request.resource.data) || request.resource.data.totalConsultations == 0));
      // `roles` is deliberately NOT in the protected-fields list above — an
      // owner legitimately updates it via arrayUnion when adding a second
      // partner service (see PartnerRoleRegisterScreen). But it must never
      // be updatable to a value containing 'admin' by anyone but an actual
      // admin, or the same escalation the create rule closes above would
      // still be reachable via update on an already-existing account.
      allow update: if isAdmin() ||
                       (isOwner(doctorId) &&
                        doesNotModify(['status', 'rating', 'totalReviews', 'totalConsultations', 'reviewCount', 'earnings', 'verificationStatus']) &&
                        (!('roles' in request.resource.data) ||
                         !('admin' in request.resource.data.roles)));
      allow delete: if isAdmin();

      // Doctor reviews subcollection
      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth() && !isDoctor();
        allow update, delete: if isAdmin();
      }
    }

    // ── Appointments ────────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Single-document reads: restrict to patient/doctor/admin only.
      // resource == null covers tx.get() on a not-yet-created slot document.
      // The last clause lets a guest (a family member joining via a signed
      // share link — see createGuestJoinLink/redeemGuestJoinLink in
      // functions/index.js) read only the one appointment their custom-token
      // claim is scoped to.
      allow get: if isAuth() && (
        resource == null ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin() ||
        (request.auth.token.guestAppointmentId != null &&
          request.auth.token.guestAppointmentId == appointmentId)
      );
      // Collection queries (e.g. slot-availability check, appointment list):
      // resource.data is null during list operations so field checks cannot be
      // used here. Allow any authenticated user to query; sensitive data is
      // already scoped by the patient/doctor writing their own records.
      allow list: if isAuth();
      // Only the booking patient can create; must set their own patientId.
      allow create: if isAuth() &&
                       request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.doctorId != request.auth.uid;
      // Patient can cancel (status update only) or reschedule (date/time/type
      // only — doctorId, patientId, fee stay locked so a reschedule can never
      // change who's billed or how much); doctor can update consultation status.
      // Guest (a family member on a 3-way call, joined via a signed share
      // link) may only mark the appointment completed — needed so a call
      // that the guest happens to be the last participant to leave still
      // gets finalized (see WhatsApp-style "last one out" logic in
      // video_call_screen.dart / guest_video_call_screen.dart).
      allow update: if isAuth() && (
        (resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'updatedAt', 'consultationId', 'date', 'time', 'consultationType'])) ||
        (resource.data.doctorId == request.auth.uid &&
          doesNotModify(['patientId', 'doctorId', 'amount', 'createdAt'])) ||
        (request.auth.token.guestAppointmentId != null &&
          request.auth.token.guestAppointmentId == appointmentId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']) &&
          request.resource.data.status == 'completed') ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Hospital OP appointments ────────────────────────────────────────────
    // Via capturePayment/captureCartPayment (functions/index.js) when
    // kRequirePayment is true — the Admin SDK there bypasses these rules
    // entirely. While kRequirePayment is false (current default, see
    // mednu's payment_config.dart), PaymentScreen's no-pay path writes this
    // doc directly from the client instead, so `create` must allow that too
    // (mirrors hospital_bill_payments' create rule above) — it was
    // previously hardcoded `false`, which silently broke every OP booking
    // made through the no-pay path.
    // The patient can read/cancel their own booking (only while it's still
    // 'booked' or 'checked_in' — cancelling a finished visit makes no
    // sense); a hospital billing-desk login scoped to this hospitalId runs
    // the OP queue (checked_in -> completed/no_show) from
    // HospitalAppointmentsScreen (mednu_doctor) — mirrors the
    // caregiver/physio/counselling accept+status-update pattern, minus
    // doctorId/guest handling which doesn't apply to a walk-in OP visit.
    match /hospital_appointments/{appointmentId} {
      allow get: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        isHospitalPartnerFor(resource.data.hospitalId)
      );
      allow list: if isAuth();
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuth() && (
        (resource.data.patientId == request.auth.uid &&
          resource.data.status in ['booked', 'checked_in'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'cancelled') ||
        (isHospitalPartnerFor(resource.data.hospitalId) &&
          resource.data.status in ['booked', 'checked_in'] &&
          request.resource.data.status in ['checked_in', 'completed', 'no_show'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'checkedInAt', 'completedAt', 'noShowAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Pre-consultation patient intake forms ───────────────────────────────
    // One doc per booking (doc id == the appointments/{id} or
    // consultations/{id} doc it's attached to — DoctorBookingFlow.submitIntake
    // in mednu writes it under whichever id the booking actually got, so it
    // covers Doctor Profile / Schedule-tab bookings (appointments) and Quick
    // Connect (consultations) alike), filled by the patient before payment
    // and attached right after — see pre_consultation_form_screen.dart +
    // doctor_booking_flow.dart (mednu) and pre_consultation_summary_card.dart
    // (mednu_doctor). Only ever read/written as single documents (never
    // queried as a collection), so no `allow list` is needed.
    match /patient_intake_forms/{appointmentId} {
      // resource == null covers the stream before the patient has submitted
      // anything yet — without this, PreConsultationSummaryCard/
      // _IntakePendingChip would get PERMISSION_DENIED instead of a graceful
      // "doesn't exist" snapshot for every appointment pre-submission.
      allow get: if isAuth() && (
        resource == null ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      // Must be the real booking's own patient — prevents writing an intake
      // doc under someone else's appointmentId/consultationId. Checked
      // against whichever collection actually has that id (exists() first,
      // short-circuiting the get() so a Quick Connect id — which has no
      // appointments/{id} doc at all — doesn't fail evaluation).
      allow create, update: if isAuth() &&
        request.resource.data.patientId == request.auth.uid &&
        (
          (exists(/databases/$(database)/documents/appointments/$(appointmentId)) &&
            get(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == request.auth.uid) ||
          (exists(/databases/$(database)/documents/consultations/$(appointmentId)) &&
            get(/databases/$(database)/documents/consultations/$(appointmentId)).data.patientId == request.auth.uid)
        );
      allow delete: if isAdmin();
    }

    // ── Health records ───────────────────────────────────────────────────────
    match /health_records/{userId}/{recordId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /prescriptions/{prescriptionId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      allow create: if isDoctor();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Period & water tracker ────────────────────────────────────────────────
    match /period_tracker/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /water_tracker/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Pregnancy ────────────────────────────────────────────────────────────
    match /pregnancy/{userId} {
      allow read, write: if isOwner(userId);

      match /journal/{entryId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Hospitals & Ambulances (public read, admin write) ───────────────────
    match /hospitals/{hospitalId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Bill-payment discount catalog — admin-defined, shown to every patient
    // paying a hospital bill (see hospital_discount_service.dart).
    match /hospital_bill_discounts/{discountId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // One record per hospital bill payment (capturePayment's bookingCollection
    // for serviceType 'hospital_bill', or written directly by the client while
    // kRequirePayment is false — see payment_screen.dart).
    match /hospital_bill_payments/{paymentId} {
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      // A hospital's own billing-desk login may read its hospital's payment
      // records (see hospital_profiles below) so staff can confirm a
      // patient's payment actually landed, in real time.
      allow read:   if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        isHospitalPartnerFor(resource.data.hospitalId)
      );
      // A hospital's own billing-desk login may mark a payment it can see as
      // verified — and *only* that field pair, never the amounts/patientId/
      // discount the payment itself records. This is the "how do hospitals
      // verify this payment" action surfaced on HospitalPaymentsScreen (mednu_doctor).
      allow update: if isAuth() && isHospitalPartnerFor(resource.data.hospitalId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hospitalVerified', 'hospitalVerifiedAt']);
      allow delete: if false;
    }

    // Hospital billing-desk partner profile — self-registered like every
    // other partner role (see PartnerRoleRegisterScreen in mednu_doctor), but
    // unlike lab/pharmacy/ambulance/caregiver it links back to an existing
    // admin-curated `hospitals/{hospitalId}` catalog entry rather than being
    // the operational entity itself. `hospitalId`/`hospitalName` may be
    // pre-filled client-side by phone-number auto-match at registration, but
    // only a Director can change them afterwards (or flip `status`) — the
    // same trust boundary every other partner role's approval already uses.
    match /hospital_profiles/{hospitalUid} {
      allow read:   if isAuth() && (isOwner(hospitalUid) || isAdmin());
      allow create: if isOwner(hospitalUid) && request.resource.data.status == 'pending';
      allow update: if (isOwner(hospitalUid) &&
                         doesNotModify(['status', 'hospitalId', 'hospitalName'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    match /ambulances/{ambulanceId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Equipment rental vendors (public read, admin write) ─────────────────
    // Admin-managed, same shape as hospitals/ambulances above — a vendor's
    // own equipment items live in `services` (type == 'equipment') tagged
    // with `sourceVendorId`, mirroring medicines_catalogue/sourcePharmacyId.
    match /equipment_vendors/{vendorId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Health education articles (public read, admin write) ────────────────
    // Patients may bump the view counter; everything else is admin-only.
    match /health_articles/{articleId} {
      allow read: if isAuth();
      allow update: if isAdmin() ||
        (isAuth() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']));
      allow create, delete: if isAdmin();
    }

    // ── Promotional banners (public read, admin write) ──────────────────────
    match /banners/{bannerId} {
      allow read:  if true; // Banners visible even on login/onboarding screen
      allow write: if adminInRoles(['marketing', 'hr']);
    }

    // ── Medicines & pharmacy ─────────────────────────────────────────────────
    match /medicines/{medicineId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Doctors specialisations (public read) ────────────────────────────────
    match /specialisations/{specId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Support tickets (written by both patients and doctors) ───────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        adminInRoles(['support', 'hr'])
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid
      );
      allow update: if adminInRoles(['support', 'hr']);
      allow delete: if adminInRoles(['support', 'hr']);
    }

    // ── Referral config (read-only for all authenticated users) ─────────────
    match /referralConfig/{doc} {
      allow read: if isAuth();
      allow write: if adminInRoles(['marketing', 'hr']);
    }

    // ── Referrals ────────────────────────────────────────────────────────────
    // The NEW user (referredUserId) creates the referral record during signup.
    // Referrer can read their own referrals; referred user can read theirs.
    match /referrals/{referralId} {
      allow read: if isAuth() && (
        resource.data.referrerId     == request.auth.uid ||
        resource.data.referredUserId == request.auth.uid ||
        adminInRoles(['marketing', 'hr'])
      );
      allow create: if isAuth() &&
        request.resource.data.referredUserId == request.auth.uid &&
        request.resource.data.referrerId     != request.auth.uid;
      allow update: if adminInRoles(['marketing', 'hr']);
      allow delete: if adminInRoles(['marketing', 'hr']);
    }

    // ── Deletion requests (account deletion) ─────────────────────────────────
    match /deletion_requests/{userId} {
      allow create: if isOwner(userId);
      allow read:   if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Consultations (realtime video/audio calls) ────────────────────────────
    //
    // Patients create requests; doctors accept/decline/end them.
    // Both parties can read and update their own session.
    match /consultations/{consultationId} {
      // Last clause: guest join (see appointments' allow get above for the
      // claim's origin) — matched via the consultation's own appointmentId
      // field rather than the doc id, since a guest's link is issued before
      // the consultation doc even exists (it's created later, when the
      // doctor starts a scheduled call). Guarded by `!= null` first so the
      // short-circuited `||` never has to evaluate resource.data.appointmentId
      // (absent on walk-in/quick-connect docs) for the common non-guest case.
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin() ||
        (request.auth.token.guestAppointmentId != null &&
          resource.data.appointmentId == request.auth.token.guestAppointmentId)
      );

      // Patients create walk-in consultation requests (callerType == 'patient').
      // Doctors create doctor-initiated calls from scheduled appointments (callerType == 'doctor').
      // Physiotherapist/Counsellor sessions reuse this exact same doc shape
      // for their own video sessions (see ProviderOutgoingCallScreen in
      // mednu_doctor) — the caller's own uid still goes in `doctorId`
      // either way, just held for a different role.
      // We key off callerType rather than isDoctor() to avoid exists() overhead and to support
      // accounts that appear in both users and doctors collections during development.
      allow create: if isAuth() && (
        (request.resource.data.callerType == 'patient' &&
          request.resource.data.patientId == request.auth.uid) ||
        (request.resource.data.callerType in ['doctor', 'physiotherapist', 'counsellor'] &&
          request.resource.data.doctorId == request.auth.uid)
      );

      // Patient may update status/cancel/session fields only.
      // Doctor may update status and medical-note fields only.
      // Guest (see allow read above) may only end the call — status/endedAt.
      // Admin may update anything.
      allow update: if isAuth() && (
        (resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'patientFcmToken', 'endedAt',
                      'missedAt', 'startedAt', 'patientNotes'])) ||
        (resource.data.doctorId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'ringingAt', 'declinedAt', 'endedAt',
                      'startedAt', 'durationSeconds', 'doctorNotes',
                      'missedAt', 'active', 'cancelledAt'])) ||
        (request.auth.token.guestAppointmentId != null &&
          resource.data.appointmentId == request.auth.token.guestAppointmentId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt'])) ||
        isAdmin()
      );

      allow delete: if isAdmin();

      // In-call text chat messages
      match /messages/{msgId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/consultations/$(consultationId))
            .data.patientId == request.auth.uid ||
          get(/databases/$(database)/documents/consultations/$(consultationId))
            .data.doctorId  == request.auth.uid ||
          isAdmin() ||
          (request.auth.token.guestAppointmentId != null &&
            get(/databases/$(database)/documents/consultations/$(consultationId))
              .data.appointmentId == request.auth.token.guestAppointmentId)
        );
        allow create: if isAuth() &&
                         request.resource.data.senderId == request.auth.uid && (
                           get(/databases/$(database)/documents/consultations/$(consultationId))
                             .data.patientId == request.auth.uid ||
                           get(/databases/$(database)/documents/consultations/$(consultationId))
                             .data.doctorId  == request.auth.uid ||
                           (request.auth.token.guestAppointmentId != null &&
                             get(/databases/$(database)/documents/consultations/$(consultationId))
                               .data.appointmentId == request.auth.token.guestAppointmentId)
                         );
        allow update, delete: if false;
      }
    }

    // ── Doctor consultation active sessions ───────────────────────────────────
    match /active_consultations/{sessionId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuth() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Doctor online status ──────────────────────────────────────────────────
    match /doctor_status/{doctorId} {
      allow read:   if isAuth();
      allow write:  if isOwner(doctorId) || isAdmin();
    }

    // ── Broadcast notifications (admin only write) ────────────────────────────
    match /broadcast_notifications/{notifId} {
      allow read:  if isAuth();
      allow write: if adminInRoles(['support', 'hr']);
    }

    // ── Service requests (diagnostics, physio, etc.) ─────────────────────────
    match /service_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      // Patient can cancel own request; admin/doctor can update status/assignment
      allow update: if isAuth() && (
        (resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'updatedAt'])) ||
        isAdmin() ||
        isDoctor()
      );
      allow delete: if isAdmin();
    }

    // ── Lab & Diagnostics partner module ────────────────────────────────────
    // Additive collections only — service_requests (above) is untouched by
    // clients here; a Cloud Function (Admin SDK, bypasses these rules)
    // mirrors between the two. See functions/index.js.

    // Core booking facts a lab must never be able to rewrite after the
    // Cloud Function created the booking from the patient's original
    // service_request — only workflow fields (status, technician,
    // report, labId-claim) are lab-writable.
    function _diagnosticBookingImmutableFields() {
      return [
        'patientId', 'patientName', 'patientPhone', 'address',
        'preferredDate', 'preferredTime', 'notes', 'testName',
        'price', 'amount', 'type', 'sourceRequestId', 'createdAt'
      ];
    }

    // Whitelist of valid status transitions a lab client may perform
    // directly. Terminal/system-only transitions ('completed' is reachable
    // only from 'report_uploaded'; 'cancelled'/'expired' are Cloud-Function
    // -only via the Admin SDK, which bypasses these rules entirely) keep a
    // compromised or buggy client from jumping straight to 'completed' and
    // triggering the earnings credit without going through the pipeline.
    function _validLabTransition(before, after) {
      let allowed = {
        'pending':              ['accepted', 'rejected'],
        'accepted':             ['technician_assigned', 'rejected'],
        'technician_assigned':  ['sample_collected'],
        'sample_collected':     ['processing'],
        'processing':           ['report_uploaded'],
        'report_uploaded':      ['completed', 'report_uploaded'],
      };
      return before == after || (before in allowed && after in allowed[before]);
    }

    match /lab_profiles/{labId} {
      // Any authenticated user can browse active (approved) labs; the owner
      // and admin can always read their own/any profile regardless of status.
      allow read: if isAuth() && (
        isOwner(labId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // Fixed to 'pending'/false so a self-registering lab can't set either
      // to its "verified" value in the very same write that creates the
      // document — which would make isLabPartner()'s active-status check
      // above meaningless.
      allow create: if isOwner(labId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // A lab can update its own profile but not self-approve/self-verify
      // or inflate its own rating. Verification documents are submitted
      // once, up front, during registration — once admin has approved the
      // profile, the owner can no longer touch `documents` either (only
      // admin can, e.g. to clear a slot for re-submission), so an approval
      // already granted against the original files can never be silently
      // invalidated by a later swap.
      // HR may verify individual documents (documentVerification only) but
      // can't approve/activate/reject/delete the partner — that status change
      // is Director-only, matching the client-side gating in
      // mednu-admin/js/app.js (_setPartnerStatus's canApproveRegistrations()).
      // `documentsVerified` (the roll-up boolean _writePartnerDocVerification
      // computes) is protected here too, alongside its per-doc source of
      // truth `documentVerification` — without this an owner could just
      // self-declare the roll-up true directly, which is the one signal
      // patients actually see as a trust badge, without HR ever touching it.
      allow update: if (isOwner(labId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();

      // A lab manages its own test catalogue; nobody else reads this
      // subcollection directly — a Cloud Function mirrors each test's public
      // fields into `lab_tests_catalogue` (Admin SDK, bypasses these rules)
      // while this lab's status is 'active'. See pharmacy_profiles'
      // `inventory` subcollection above for the identical pattern.
      match /tests/{testId} {
        allow read, write: if isOwner(labId) || isAdmin();
      }
    }

    match /diagnostic_bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.labId == request.auth.uid ||
        (resource.data.labId == null && isLabPartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // Already-owning lab: any workflow-field update, but only along a
        // valid status transition and never touching the immutable core.
        // `labId` itself is pinned here (not just listed in the immutable
        // fields, which only covers patient/booking fields) — otherwise an
        // owning lab could reassign a claimed booking to an arbitrary UID
        // mid-transition, bypassing the claim-from-null branch below.
        (resource.data.labId == request.auth.uid &&
          request.resource.data.labId == resource.data.labId &&
          doesNotModify(_diagnosticBookingImmutableFields()) &&
          _validLabTransition(resource.data.status, request.resource.data.status)) ||
        // Claiming an unclaimed booking: labId must move from null to the
        // caller, and the resulting status can only be 'accepted' or
        // 'rejected' — claim-and-complete in one write is never allowed.
        (resource.data.labId == null && isLabPartner() &&
          request.resource.data.labId == request.auth.uid &&
          doesNotModify(_diagnosticBookingImmutableFields()) &&
          request.resource.data.status in ['accepted', 'rejected'])
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow create, delete: if isAdmin();
    }

    match /diagnostic_reports/{reportId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.labId == request.auth.uid ||
        isAdmin()
      );
      // The uploader must both assert labId == self AND actually own the
      // referenced booking — ties report creation to real booking
      // ownership instead of trusting a self-asserted field.
      allow create: if isAuth() &&
                       request.resource.data.labId == request.auth.uid &&
                       get(/databases/$(database)/documents/diagnostic_bookings/$(request.resource.data.bookingId)).data.labId == request.auth.uid;
      // Reports are append-only (each re-upload is a new version, see
      // lab_booking_service.dart) — never mutated or removed by clients.
      allow update, delete: if isAdmin();
    }

    match /lab_transactions/{txId} {
      allow read: if isAuth() && (resource.data.labId == request.auth.uid || isAdmin());
      // Immutable ledger — written only by the Cloud Function mirror on the
      // completed edge, mirroring the wallet architecture's rule that a
      // balance/ledger is never written directly by a client.
      allow write: if false;
    }

    // ── Pharmacy & Medical Equipment partner module ─────────────────────────
    // Additive collections only — `orders` (medicine) and `service_requests`
    // (equipment) are untouched by clients here; a Cloud Function
    // (Admin SDK, bypasses these rules) mirrors between them and
    // `pharmacy_orders`. See functions/index.js.

    function _pharmacyOrderImmutableFields() {
      return [
        'sourceCollection', 'sourceId', 'orderType', 'patientId', 'patientName',
        'patientPhone', 'deliveryAddress', 'itemCount', 'totalAmount', 'createdAt'
      ];
    }

    // Same shape as Lab's _validLabTransition — a compromised/buggy pharmacy
    // client can't jump straight to 'delivered' (and trigger the earnings
    // credit) without going through the pipeline.
    function _validPharmacyTransition(before, after) {
      let allowed = {
        'pending':               ['prescription_required', 'verified', 'cancelled'],
        'prescription_required': ['verified', 'cancelled'],
        'verified':              ['packed', 'cancelled'],
        'packed':                ['out_for_delivery', 'cancelled'],
        'out_for_delivery':      ['delivered', 'cancelled'],
      };
      return before == after || (before in allowed && after in allowed[before]);
    }

    match /pharmacy_profiles/{pharmacyId} {
      allow read: if isAuth() && (
        isOwner(pharmacyId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // See lab_profiles' create rule above for why status/isVerified are
      // fixed here rather than left to the client.
      allow create: if isOwner(pharmacyId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // See lab_profiles' update rule above for why `documents` locks once
      // `status == 'active'`, and for why HR is limited to
      // documentVerification-only while approval is Director-only.
      allow update: if (isOwner(pharmacyId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();

      // A pharmacy manages its own stock; nobody else reads this
      // subcollection directly (the Orders/Inventory screens never query
      // across pharmacies). Patients see it via a separate, published copy:
      // the `onPharmacyInventoryWrite` Cloud Function mirrors each item into
      // `medicines_catalogue` (Admin SDK, bypasses these rules) while this
      // pharmacy's status is 'active'.
      match /inventory/{itemId} {
        allow read, write: if isOwner(pharmacyId) || isAdmin();
      }
    }

    match /pharmacy_orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.pharmacyId == request.auth.uid ||
        (resource.data.pharmacyId == null && isPharmacyPartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // `pharmacyId` is pinned here (see diagnostic_bookings' equivalent
        // branch for why) so an owning pharmacy can't reassign a claimed
        // order to an arbitrary UID mid-transition.
        (resource.data.pharmacyId == request.auth.uid &&
          request.resource.data.pharmacyId == resource.data.pharmacyId &&
          doesNotModify(_pharmacyOrderImmutableFields()) &&
          _validPharmacyTransition(resource.data.status, request.resource.data.status)) ||
        // Claiming an unclaimed order: pharmacyId moves from null to the
        // caller, and the resulting status can only be one of the three
        // "just accepted this" outcomes — never straight to packed/delivered.
        (resource.data.pharmacyId == null && isPharmacyPartner() &&
          request.resource.data.pharmacyId == request.auth.uid &&
          doesNotModify(_pharmacyOrderImmutableFields()) &&
          request.resource.data.status in ['prescription_required', 'verified', 'cancelled'])
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow create, delete: if isAdmin();
    }

    match /pharmacy_order_items/{itemId} {
      // Item docs don't carry patientId/pharmacyId themselves (see
      // functions/index.js) — ownership is resolved via the parent order.
      allow read: if isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/pharmacy_orders/$(resource.data.orderId)).data.patientId == request.auth.uid ||
        get(/databases/$(database)/documents/pharmacy_orders/$(resource.data.orderId)).data.pharmacyId == request.auth.uid
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow write: if isAdmin();
    }

    match /pharmacy_transactions/{txId} {
      allow read: if isAuth() && (resource.data.pharmacyId == request.auth.uid || isAdmin());
      // Immutable ledger — written only by the Cloud Function mirror on the
      // delivered edge.
      allow write: if false;
    }

    // ── Ambulance partner module ────────────────────────────────────────────
    // Additive collections only — `service_requests` is never written by the
    // ambulance client; a Cloud Function (Admin SDK, bypasses these rules)
    // mirrors between it and `ambulance_requests`. See functions/index.js.

    function _ambulanceRequestImmutableFields() {
      return [
        'sourceRequestId', 'type', 'patientId', 'patientName', 'patientPhone',
        'pickupAddress', 'dropAddress', 'distanceKm', 'etaMinutes', 'fare',
        'emergencyType', 'requestedAt', 'createdAt'
      ];
    }

    // Same shape as Lab's _validLabTransition. 'completed' is reachable only
    // from 'arrived', so a compromised or buggy client can't jump straight to
    // it and trigger the trip record + earnings credit without actually
    // having driven the run.
    function _validAmbulanceTransition(before, after) {
      let allowed = {
        'pending':  ['accepted', 'cancelled'],
        'accepted': ['enRoute', 'cancelled'],
        'enRoute':  ['arrived'],
        'arrived':  ['completed'],
      };
      return before == after || (before in allowed && after in allowed[before]);
    }

    match /ambulance_profiles/{ambulanceId} {
      allow read: if isAuth() && (
        isOwner(ambulanceId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // See lab_profiles' create rule above for why status/isVerified are
      // fixed here rather than left to the client.
      allow create: if isOwner(ambulanceId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // A partner can update its own profile but not self-approve/self-verify
      // or inflate its own rating/trip count. See lab_profiles' update rule
      // above for why `documents` locks once `status == 'active'`, and for
      // why HR is limited to documentVerification-only while approval is
      // Director-only.
      allow update: if (isOwner(ambulanceId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'totalTrips', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    match /ambulance_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.ambulanceId == request.auth.uid ||
        (resource.data.ambulanceId == null && isAmbulancePartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // Already-owning partner: workflow updates along a valid transition
        // only, never touching the immutable core. `ambulanceId` is pinned
        // here (see diagnostic_bookings' equivalent branch for why) so an
        // owning partner can't reassign a claimed request to an arbitrary
        // UID mid-transition.
        (resource.data.ambulanceId == request.auth.uid &&
          request.resource.data.ambulanceId == resource.data.ambulanceId &&
          doesNotModify(_ambulanceRequestImmutableFields()) &&
          _validAmbulanceTransition(resource.data.status, request.resource.data.status)) ||
        // Claiming an unclaimed request: ambulanceId moves from null to the
        // caller, and the resulting status can only be 'accepted' (claim) or
        // 'cancelled' (declining a request nobody had taken yet) — never
        // claim-and-complete in a single write.
        (resource.data.ambulanceId == null && isAmbulancePartner() &&
          request.resource.data.ambulanceId == request.auth.uid &&
          doesNotModify(_ambulanceRequestImmutableFields()) &&
          request.resource.data.status in ['accepted', 'cancelled'])
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow create, delete: if isAdmin();
    }

    match /ambulance_trips/{tripId} {
      allow read: if isAuth() && (resource.data.ambulanceId == request.auth.uid || isAdmin());
      // Immutable trip record — written only by the Cloud Function on the
      // completed edge, alongside the ledger credit.
      allow write: if false;
    }

    match /ambulance_transactions/{txId} {
      allow read: if isAuth() && (resource.data.ambulanceId == request.auth.uid || isAdmin());
      // Immutable ledger — never written directly by a client.
      allow write: if false;
    }

    // ── Caregiver partner module ────────────────────────────────────────────
    // Additive collections only — `service_requests` is never written by the
    // caregiver client; a Cloud Function mirrors between it and
    // `caregiver_visits`. See functions/index.js.

    function _caregiverVisitImmutableFields() {
      return [
        'sourceRequestId', 'sourceType', 'type', 'patientId', 'patientName',
        'patientAge', 'address', 'scheduledAt', 'durationMinutes', 'fare',
        'createdAt'
      ];
    }

    function _validCaregiverTransition(before, after) {
      let allowed = {
        'scheduled': ['checkedIn', 'cancelled', 'missed'],
        'checkedIn': ['completed'],
      };
      return before == after || (before in allowed && after in allowed[before]);
    }

    // Reads the parent visit so the tasks/notes subcollection rules can be
    // scoped to whoever actually owns that visit, rather than trusting a
    // self-asserted field on the child doc.
    function _caregiverVisit(visitId) {
      return get(/databases/$(database)/documents/caregiver_visits/$(visitId)).data;
    }

    match /caregiver_profiles/{caregiverId} {
      allow read: if isAuth() && (
        isOwner(caregiverId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // See lab_profiles' create rule above for why status/isVerified are
      // fixed here rather than left to the client.
      allow create: if isOwner(caregiverId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // See lab_profiles' update rule above for why `documents` locks once
      // `status == 'active'`, and for why HR is limited to
      // documentVerification-only while approval is Director-only.
      allow update: if (isOwner(caregiverId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'totalVisits', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    match /caregiver_visits/{visitId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid ||
        (resource.data.caregiverId == null && isCaregiverPartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // `caregiverId` is pinned here (see diagnostic_bookings' equivalent
        // branch for why) so an owning caregiver can't reassign a claimed
        // visit to an arbitrary UID mid-transition.
        (resource.data.caregiverId == request.auth.uid &&
          request.resource.data.caregiverId == resource.data.caregiverId &&
          doesNotModify(_caregiverVisitImmutableFields()) &&
          _validCaregiverTransition(resource.data.status, request.resource.data.status)) ||
        // Claiming an unclaimed visit: caregiverId moves from null to the
        // caller. Unlike Ambulance, the status itself does NOT change on a
        // claim — a claimed visit stays 'scheduled' until check-in — so the
        // claim rule pins the status rather than listing allowed new ones.
        (resource.data.caregiverId == null && isCaregiverPartner() &&
          request.resource.data.caregiverId == request.auth.uid &&
          doesNotModify(_caregiverVisitImmutableFields()) &&
          resource.data.status == 'scheduled' &&
          request.resource.data.status == 'scheduled')
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow create, delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isAuth() && (
          _caregiverVisit(visitId).patientId == request.auth.uid ||
          _caregiverVisit(visitId).caregiverId == request.auth.uid ||
          isAdmin()
        );
        // The assigned caregiver ticks items off — and may ONLY touch
        // `isDone`; the checklist's wording is seeded by the Cloud Function
        // and can't be rewritten after the fact.
        allow update: if isAuth() &&
                         _caregiverVisit(visitId).caregiverId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDone']);
        // Seeded only by the Cloud Function mirror (Admin SDK).
        allow create, delete: if isAdmin();
      }

      match /notes/{noteId} {
        allow read: if isAuth() && (
          _caregiverVisit(visitId).patientId == request.auth.uid ||
          _caregiverVisit(visitId).caregiverId == request.auth.uid ||
          isAdmin()
        );
        // Caregiver-authored, append-only: a care note is a clinical record,
        // so once written it is never edited or erased by a client.
        allow create: if isAuth() &&
                         _caregiverVisit(visitId).caregiverId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /caregiver_transactions/{txId} {
      allow read: if isAuth() && (resource.data.caregiverId == request.auth.uid || isAdmin());
      // Immutable ledger — written only by the Cloud Function mirror on the
      // completed edge.
      allow write: if false;
    }

    // ── Physiotherapy & Counselling partner modules ──────────────────────────
    // Additive collections only — `service_requests` is never written by
    // either client; a Cloud Function mirrors between it and
    // `physio_sessions`/`counselling_sessions`. See functions/index.js.
    // Single-practitioner services (unlike Lab/Pharmacy): claiming a session
    // is a single write, exactly like Ambulance — providerId moves from null
    // to the caller and status moves from 'pending' to 'accepted' or
    // 'cancelled' (decline) in the same write, never claim-and-complete.

    function _sessionImmutableFields() {
      return [
        'sourceRequestId', 'type', 'patientId', 'patientName', 'patientPhone',
        'address', 'preferredDate', 'preferredTime', 'notes', 'price',
        'amount', 'sessionTitle', 'createdAt'
      ];
    }

    // Shared by physio_sessions and counselling_sessions — same shape as
    // Ambulance's _validAmbulanceTransition.
    function _validSessionTransition(before, after) {
      let allowed = {
        'pending':  ['accepted', 'cancelled'],
        'accepted': ['in_progress', 'cancelled'],
        'in_progress': ['completed'],
      };
      return before == after || (before in allowed && after in allowed[before]);
    }

    match /physio_sessions/{sessionId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.physiotherapistId == request.auth.uid ||
        (resource.data.physiotherapistId == null && isPhysiotherapistPartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // Already-owning provider: workflow updates along a valid transition
        // only. `physiotherapistId` itself is pinned here (not just listed in
        // _sessionImmutableFields, which only covers patient/booking fields)
        // — otherwise an owning provider could reassign a claimed session to
        // an arbitrary UID mid-transition, bypassing the claim-from-null path
        // below entirely and forging who a patient-visible session mirrors
        // back to service_requests as `assignedTo`.
        (resource.data.physiotherapistId == request.auth.uid &&
          request.resource.data.physiotherapistId == resource.data.physiotherapistId &&
          doesNotModify(_sessionImmutableFields()) &&
          _validSessionTransition(resource.data.status, request.resource.data.status)) ||
        // Claiming an unclaimed session: physiotherapistId moves from null to
        // the caller, and the resulting status can only be 'accepted' (claim)
        // or 'cancelled' (declining a session nobody had taken yet).
        (resource.data.physiotherapistId == null && isPhysiotherapistPartner() &&
          request.resource.data.physiotherapistId == request.auth.uid &&
          doesNotModify(_sessionImmutableFields()) &&
          request.resource.data.status in ['accepted', 'cancelled'])
      );
      // Created only by the Cloud Function mirror (Admin SDK bypasses rules).
      allow create, delete: if isAdmin();
    }

    match /physio_transactions/{txId} {
      allow read: if isAuth() && (resource.data.physiotherapistId == request.auth.uid || isAdmin());
      // Immutable ledger — written only by the Cloud Function mirror on the
      // completed edge.
      allow write: if false;
    }

    match /physiotherapist_profiles/{physiotherapistId} {
      allow read: if isAuth() && (
        isOwner(physiotherapistId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // Unlike the older partner-profile collections (whose `create` rule
      // has no field restriction at all), this requires a brand-new profile
      // to start in 'pending' — otherwise a self-registering user could set
      // `status: 'active'` in the very same write that creates the document,
      // making isPhysiotherapistPartner()'s active-status check meaningless.
      allow create: if isOwner(physiotherapistId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // See lab_profiles' update rule above for why `documents` locks once
      // `status == 'active'`, and for why HR is limited to
      // documentVerification-only while approval is Director-only.
      allow update: if (isOwner(physiotherapistId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'totalSessions', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    match /counselling_sessions/{sessionId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        (resource.data.counsellorId == null && isCounsellorPartner()) ||
        isAdmin()
      );
      allow update: if isAuth() && (
        isAdmin() ||
        // See physio_sessions' equivalent branch above for why
        // `counsellorId` is pinned here, not just listed in the immutable
        // fields helper.
        (resource.data.counsellorId == request.auth.uid &&
          request.resource.data.counsellorId == resource.data.counsellorId &&
          doesNotModify(_sessionImmutableFields()) &&
          _validSessionTransition(resource.data.status, request.resource.data.status)) ||
        (resource.data.counsellorId == null && isCounsellorPartner() &&
          request.resource.data.counsellorId == request.auth.uid &&
          doesNotModify(_sessionImmutableFields()) &&
          request.resource.data.status in ['accepted', 'cancelled'])
      );
      allow create, delete: if isAdmin();
    }

    match /counselling_transactions/{txId} {
      allow read: if isAuth() && (resource.data.counsellorId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /counsellor_profiles/{counsellorId} {
      allow read: if isAuth() && (
        isOwner(counsellorId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // See physiotherapist_profiles' create rule above for why `status`/`isVerified`
      // can't be self-set to their "verified" values at creation.
      allow create: if isOwner(counsellorId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // See lab_profiles' update rule above for why HR is limited to
      // documentVerification-only while approval is Director-only.
      allow update: if (isOwner(counsellorId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'totalReviews', 'totalSessions', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    // ── Booking support chat ───────────────────────────────────────────────────
    // `bookingId` spans several booking collections (diagnostic_bookings,
    // pharmacy_orders, ambulance_requests, caregiver_visits), so participation
    // cannot be resolved with a get() here — it is carried on the message.
    // Reads were `isAuth()` alone, which exposed every booking's support thread
    // to any signed-in account; scoped to the sender, anyone the message lists
    // in `participants`, and admins. `senderId` is already mandatory on create.
    match /booking_support/{bookingId}/messages/{msgId} {
      allow read: if isAuth() && (
        resource.data.senderId == request.auth.uid ||
        (resource.data.keys().hasAny(['participants']) &&
          resource.data.participants.hasAny([request.auth.uid])) ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Analytics & feedback ─────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read:   if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // ── Doctor reviews (public-facing) ───────────────────────────────────────
    match /doctor_reviews/{reviewId} {
      allow read:   if isAuth();
      // !isDoctor() was replaced with a self-review guard — using exists() in
      // rules inside a transaction is unreliable and blocks dual-account test users.
      allow create: if isAuth() &&
                       request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.doctorId  != request.auth.uid;
      allow update, delete: if adminInRoles(['hr']);
    }

    // ── Doctor rating summary (aggregate, Cloud-Function-only) ────────────────
    match /doctor_rating_summary/{doctorId} {
      allow read: if isAuth();
      // Written solely by the onReviewCreated / onFeedbackCreated triggers via
      // the Admin SDK (which bypasses these rules). Client writes are denied so
      // the aggregate cannot be forged from an app.
      allow create, update, delete: if isAdmin();
    }

    // ── Appointment review lock (prevents duplicate reviews) ──────────────────
    match /appointment_reviews/{appointmentId} {
      // resource == null covers the transaction GET on a not-yet-created lock doc.
      // Without this, tx.get() on a non-existent doc always throws PERMISSION_DENIED.
      allow read: if isAuth() && (
        resource == null ||
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      // Patient writes via transaction (tx.set uses create or update internally).
      allow create: if isAuth() &&
                       request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.doctorId  != request.auth.uid;
      // Allow patient to set reviewed=true (idempotent lock within transaction).
      allow update: if (isAuth() &&
                         resource.data.patientId == request.auth.uid &&
                         resource.data.doctorId  != request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['reviewed', 'reviewId', 'createdAt'])) ||
                       isAdmin();
      allow delete: if isAdmin();
    }

    // ── Doctor specialization change requests ─────────────────────────────────
    match /doctor_specialization_requests/{reqId} {
      allow read: if isAuth() && (
        resource.data.doctorId == request.auth.uid || isAdmin()
      );
      allow create: if isDoctor() &&
                       request.resource.data.doctorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Post-consultation feedback (patient → doctor) ─────────────────────────
    match /feedbacks/{feedbackId} {
      allow read: if isAuth() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientId == request.auth.uid ||
        adminInRoles(['hr'])
      );
      // Any authenticated user can submit feedback as long as they own the patientId
      // and are not rating themselves (doctorId != their own uid).
      allow create: if isAuth() &&
                       request.resource.data.patientId == request.auth.uid &&
                       request.resource.data.doctorId != request.auth.uid;
      allow update, delete: if adminInRoles(['hr']);
    }

    // ── Payments — the unified escrow ledger (Payment Distribution & ──────────
    // Settlement Engine, functions/index.js). Written exclusively by
    // capturePayment/issueRefund/the settlement functions via the Admin SDK,
    // which bypasses these rules entirely — so `allow write: if false` here
    // is absolute, not just "admin console only". A client was previously
    // able to `create` one of these directly (matching only on `userId`),
    // which is what made the consultation_screen.dart phantom-paid booking
    // possible; that hole is closed by removing client create entirely.
    match /payments/{paymentId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        adminInRoles(['finance', 'hr'])
      );
      allow write: if false;
    }

    // ── Commission rules — admin-configured, read by capturePayment ───────────
    match /commission_rules/{serviceType} {
      allow read: if isAuth();
      allow write: if false; // setCommissionRule (Admin SDK) only
    }

    // ── Coupons ─────────────────────────────────────────────────────────────
    match /coupons/{couponCode} {
      allow read: if isAuth();
      allow write: if false; // createCoupon/updateCoupon/toggleCoupon/deactivateCoupon only

      match /redemptions/{userId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // capturePayment (Admin SDK) only
      }
    }

    // ── Festival campaigns — simple admin CRUD, same pattern as banners ───────
    match /campaigns/{campaignId} {
      allow read: if true; // public — patient home banner carousel
      allow write: if isAdmin();
    }

    // ── Settlements — batched provider payouts ────────────────────────────────
    match /settlements/{settlementId} {
      allow read: if isAuth() && (
        resource.data.providerId == request.auth.uid || isAdmin()
      );
      allow write: if false; // approveSettlement/holdSettlement/markSettlementPaid/etc only
    }

    // ── Settlement frequency config (daily/weekly/monthly/manual) ─────────────
    match /settlement_config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Provider wallets — real-time balance doc, one per provider, any ────────
    // vertical (doctor/lab/pharmacy/ambulance/caregiver share this collection)
    match /provider_wallets/{providerId} {
      // Every vertical except Hospital is keyed by the provider's own uid,
      // so isOwner(providerId) covers them. Hospital is the one exception —
      // `providerId` there is the hospitals/{hospitalId} catalog id, not any
      // billing-desk login's uid (see _PROVIDER_FIELD_BY_SERVICE in
      // functions/index.js), so it needs the hospitalId-scoped check too.
      allow read: if isOwner(providerId) || isAdmin() || isHospitalPartnerFor(providerId);
      allow write: if false; // settlement engine (Admin SDK) only
    }

    // ── Provider-side notification center — mirrors patient_notifications ─────
    match /provider_notifications/{providerId}/items/{itemId} {
      allow read: if isOwner(providerId) || isAdmin();
      allow update: if isOwner(providerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // ── Refunds ─────────────────────────────────────────────────────────────
    match /refunds/{refundId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false; // issueRefund (Admin SDK) only
    }

    // ── Audit logs — every admin financial action, immutable ──────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Favourite doctors subcollection ───────────────────────────────────────
    match /users/{userId}/favourite_doctors/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ── Nutrition appointments ────────────────────────────────────────────────
    match /nutrition_appointments/{apptId} {
      // The nutritionist is chosen by the patient at booking time (like a
      // doctor appointment, unlike the claim-from-a-pool pattern every other
      // partner module uses) — `nutritionistId` is already set on create, so
      // the assigned nutritionist just needs read/limited-update access to
      // their own appointments. Nutritionist registration itself now goes
      // through `nutritionist_profiles` (see below) exactly like every other
      // role — this block only ever concerned appointment access, which
      // never depended on how the nutritionist account was provisioned.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.nutritionistId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])) ||
        (resource.data.nutritionistId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'providerNotes'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Meal tracking (per-user nutrition logs) ───────────────────────────────
    match /meal_tracking/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Nutrition goals ───────────────────────────────────────────────────────
    match /nutrition_goals/{goalId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Water tracking (nutrition module) ────────────────────────────────────
    match /water_tracking/{docId} {
      allow read, write: if isAuth() && (
        request.auth.uid != null &&
        (resource == null || resource.data.userId == request.auth.uid)
      );
    }

    // ── BMI tracking (per-user readings) ──────────────────────────────────────
    match /bmi_logs/{logId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Diet plans (admin-managed, public read) ───────────────────────────────
    match /diet_plans/{planId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Physiotherapists (public read; mirrored from physiotherapist_profiles) ─
    // Written only by `onPhysiotherapistProfileWriteForVisibility`'s Cloud
    // Function mirror (Admin SDK, bypasses these rules), same pattern as
    // `nutritionists` below.
    match /physiotherapists/{physiotherapistId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Counsellors (public read; mirrored from counsellor_profiles) ─────────
    // Written only by `onCounsellorProfileWriteForVisibility`'s Cloud
    // Function mirror (Admin SDK, bypasses these rules), same pattern as
    // `physiotherapists` above.
    match /counsellors/{counsellorId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Nutritionists (public read; mirrored from nutritionist_profiles) ─────
    // Written only by `onNutritionistProfileWriteForVisibility`'s Cloud
    // Function mirror (Admin SDK, bypasses these rules), same as
    // `caregivers`/`medicines_catalogue`/`lab_tests_catalogue`.
    match /nutritionists/{nutritionistId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // A nutritionist manages their own private profile; approval is what
    // makes them show up in `nutritionists` above (see
    // onNutritionistProfileWriteForVisibility, functions/index.js). Same
    // shape as caregiver_profiles.
    match /nutritionist_profiles/{nutritionistId} {
      allow read: if isAuth() && (
        isOwner(nutritionistId) || adminInRoles(['hr']) || resource.data.status == 'active'
      );
      // See lab_profiles' create rule (above) for why status/isVerified are
      // fixed here rather than left to the client.
      allow create: if isOwner(nutritionistId) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      // See lab_profiles' update rule above for why HR is limited to
      // documentVerification-only while approval is Director-only.
      allow update: if (isOwner(nutritionistId) &&
                         doesNotModify(['status', 'isVerified', 'rating', 'reviewCount', 'documentVerification', 'documentsVerified']) &&
                         (resource.data.status != 'active' || doesNotModify(['documents']))) ||
                       (adminInRoles(['hr']) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['documentVerification', 'documentsVerified', 'updatedAt', 'updatedBy'])) ||
                       isDirector();
      allow delete: if isDirector();
    }

    // ── Pregnancy profiles ────────────────────────────────────────────────────
    match /pregnancy_profiles/{profileId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Pregnancy weekly logs ─────────────────────────────────────────────────
    match /pregnancy_weekly_data/{logId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuth() && resource.data.patientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Pregnancy checkups ────────────────────────────────────────────────────
    match /pregnancy_checkups/{checkupId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow delete: if isAdmin();
    }

    // ── Pregnancy medicines ───────────────────────────────────────────────────
    match /pregnancy_medicines/{medId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && (
        request.resource.data.patientId == request.auth.uid || isDoctor()
      );
      allow update: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow delete: if isAdmin() || isDoctor();
    }

    // ── Pregnancy alerts (emergency reports) ──────────────────────────────────
    match /pregnancy_alerts/{alertId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin() || isDoctor();
      allow delete: if isAdmin();
    }

    // ── Pregnancy doctor notes ────────────────────────────────────────────────
    match /pregnancy_doctor_notes/{noteId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isDoctor();
      allow update: if isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Operation Logs ──────────────────────────────────────────────────────────
    // Authenticated users (patients, doctors) can write their own logs.
    // Only admins can read all logs. Users cannot read or edit their own logs
    // after creation (append-only from the client perspective).
    match /operation_logs/{logId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'userType', 'action', 'status', 'timestamp', 'expiresAt']);
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Saved addresses (user address book) ─────────────────────────────────
    match /users/{userId}/saved_addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }

    // ── Health reports (generated patient reports) ────────────────────────────
    match /reports/{reportId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && (
        request.resource.data.patientId == request.auth.uid || isDoctor()
      );
      allow update: if isAdmin() || isDoctor();
      allow delete: if isAdmin();
    }

    // ── Maternity cases ───────────────────────────────────────────────────────
    match /maternity_cases/{caseId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow delete: if isAdmin();
    }

    // ── Maternity alerts ──────────────────────────────────────────────────────
    match /maternity_alerts/{alertId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin() || isDoctor();
      allow delete: if isAdmin();
    }

    // ── Caregivers (admin-managed, public read for authenticated patients) ────
    match /caregivers/{caregiverId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Care Assistants (admin-managed, public read for authenticated patients) ─
    match /care_assistants/{assistantId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Medicine catalogue (admin-managed, public read for patients) ─────────
    match /medicines_catalogue/{medicineId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // Mirror of every active lab's test catalogue — see lab_profiles'
    // `tests` subcollection and `onLabTestInventoryWrite` (functions/index.js).
    match /lab_tests_catalogue/{testId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Prescription uploads (patient uploads photo → pharmacist reviews) ─────
    match /prescription_uploads/{uploadId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Orders (medicine delivery orders) ────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      // Patients may self-update their cancel fields and — additively —
      // the prescription-upload fields (url/fileType/uploadedAt). They may
      // NEVER set prescriptionVerified/prescriptionRejectedReason
      // themselves — that verdict is written only by the Cloud Function
      // mirror from the assigned pharmacy's decision (see
      // functions/index.js, onPharmacyOrderStatusChange), which uses the
      // Admin SDK and bypasses this rule entirely.
      allow update: if isAuth() && (
        (resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'cancelReason', 'updatedAt',
              'prescriptionUrl', 'prescriptionFileType', 'prescriptionUploadedAt'
            ])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Health data (vitals, health dashboard) ────────────────────────────────
    match /health_data/{userId} {
      allow read, write: if isOwner(userId) || isAdmin() || isDoctor();
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin() || isDoctor();
      }
    }

    match /vitals/{docId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isAdmin() || isDoctor()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Period tracker (extended: daily logs + cycles) ────────────────────────
    match /period_cycles/{docId} {
      allow read, write: if isAuth() && request.auth.uid != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    match /period_daily/{docId} {
      allow read, write: if isAuth() && request.auth.uid != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // ── Water logs (extended water tracking) ──────────────────────────────────
    match /water_logs/{docId} {
      allow read, write: if isAuth() && request.auth.uid != null &&
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // ── Server-driven reminder queue ───────────────────────────────────────────
    // Client writes one row per future one-time reminder (period pre-alert,
    // wellness check-in, booking/appointment reminder); a scheduled Cloud
    // Function (processDueReminders) delivers them via the Admin SDK, which
    // bypasses these rules entirely — so no client `update` is granted here.
    // `uid` must match the writer so nobody can enqueue a push to someone else.
    match /scheduled_reminders/{docId} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      // resource == null lets a batch delete-by-ID sweep IDs that were never
      // created (e.g. cancelling a wellness series before every slot in it
      // was written) without failing the whole batch on a not-found doc.
      allow read, delete: if isAuth() &&
        (resource == null || resource.data.uid == request.auth.uid);
    }

    // ── Doctor notifications ──────────────────────────────────────────────────
    match /doctor_notifications/{doctorId}/items/{notifId} {
      allow read: if isOwner(doctorId) || isAdmin();
      allow create: if isAuth();
      allow update: if isOwner(doctorId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(doctorId) || isAdmin();
    }

    // ── Doctor wallet / earnings ──────────────────────────────────────────────
    match /wallets/{doctorId} {
      allow read: if isOwner(doctorId) || isAdmin();
      allow write: if isAdmin();
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuth() && (
        resource.data.doctorId == request.auth.uid || adminInRoles(['finance', 'hr'])
      );
      allow create: if adminInRoles(['finance', 'hr']);
      allow update, delete: if false;
    }

    // ── Patient wallet ledger (canonical, immutable) ──────────────────────────
    // Every patient wallet mutation writes exactly one entry here, in the same
    // Cloud Function transaction as the users/{uid} balance update. Written by
    // the Admin SDK only — same convention as lab_transactions et al.
    match /wallet_ledger/{entryId} {
      // See provider_wallets above — Hospital ledger entries are written
      // with `uid: hospitalId` (the catalog id), not a billing-desk uid.
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin() || isHospitalPartnerFor(resource.data.uid)
      );
      allow write: if false;
    }

    // ── Razorpay order records (server-side amount authority) ─────────────────
    // createRazorpayOrder writes these; verifyRazorpayPayment reads the ordered
    // amount from here to decide what to credit. A client must never be able to
    // create or alter one, or the wallet top-up amount stops being trustworthy.
    match /razorpay_orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // ── Razorpay verified-payment audit trail (server-written) ────────────────
    match /razorpay_payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Emergency contacts (patient-managed) ──────────────────────────────────
    match /emergency_contacts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Support chats (patient ↔ doctor support) ──────────────────────────────
    match /support_chats/{chatId} {
      allow read: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId  == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Scoped to the same participant set as the parent chat doc — an
      // unqualified `if isAuth()` here let any signed-in account read every
      // support conversation in the system. The chat doc id is the owning
      // uid (live_chat_screen.dart uses .doc(uid)), so the cheap ownership
      // check short-circuits before the parent get() in the common case.
      match /messages/{msgId} {
        allow read: if isAuth() && (
          isOwner(chatId) ||
          isAdmin() ||
          get(/databases/$(database)/documents/support_chats/$(chatId)).data.patientId == request.auth.uid ||
          get(/databases/$(database)/documents/support_chats/$(chatId)).data.doctorId  == request.auth.uid
        );
        allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── App settings / config (admin-managed, public read) ───────────────────
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Services catalogue (admin-managed, public read) ───────────────────────
    match /services/{serviceId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Patients collection (used by doctor app for patient lookup) ───────────
    match /patients/{patientId} {
      allow read: if isAuth() && (
        isOwner(patientId) || isDoctor() || isAdmin()
      );
      allow create: if isOwner(patientId);
      allow update: if isOwner(patientId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Broadcast notifications (admin sends, admin reads history) ──────────────
    // Different from broadcast_notifications — this is admin → FCM pipeline.
    match /broadcasts/{broadcastId} {
      allow read:  if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Admin critical alerts (mednu-admin live notification bell) ──────────────
    // Written server-side only, by 9 Cloud Function call sites (onSeriousComplaint,
    // onEmergencyDoctorRequest, _sendAdminAlert — failed/large payments, settlement
    // failures). Read by every admin role via the shared bell (initAdminAlertsListener,
    // mednu-admin/js/app.js) — not role-scoped, since emergencies/complaints/payment
    // failures are relevant to every profile including Director. Had NO rule at all
    // until now: an unmatched collection defaults to deny, so this onSnapshot
    // listener (called unconditionally from initDashboard() for every role) was
    // silently PERMISSION_DENIED for 100% of admins since the bell wiring was added.
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if false; // Cloud Functions (Admin SDK) only
      // Marking an alert read/unread is the only client write (see the bell's
      // mark-one-read and mark-all-read batch write in app.js) — no other field
      // is ever touched by a client.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── Order support chat (patient ↔ support during medicine delivery) ─────────
    match /order_chats/{orderId}/messages/{msgId} {
      // Ownership resolved via the parent `orders` doc — an unqualified
      // `if isAuth()` let any signed-in account read every order's delivery
      // conversation (addresses, medicine names, phone numbers).
      allow read:   if isAuth() && (
        isAdmin() ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.patientId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Report triggers (admin triggers Cloud Function to generate reports) ──────
    match /report_triggers/{triggerId} {
      allow create: if isAdmin();
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Weekly quality reports (generated by Cloud Function, read by admin) ──────
    match /weekly_quality_reports/{reportId} {
      allow read:   if adminInRoles(['hr']);
      allow create: if adminInRoles(['hr']);
      allow update, delete: if false;
    }

    // ── Appointment slot locks (atomic double-booking prevention) ────────────
    // ID format: {doctorId}_{date}_{time}. Created atomically inside a
    // Firestore transaction by the patient who books; deleted on cancellation.
    match /appointment_slots/{lockId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.patientId == request.auth.uid;
      // Patients can delete their own lock (slot freed on cancellation).
      allow delete: if isAuth() && (resource.data.patientId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // ── Patient wallet ────────────────────────────────────────────────────────
    // Seeded once at signup with balance 0 (auth_provider.dart); no client
    // ever updates it afterwards, so `balance` here is admin-only — a client
    // must not have a write path to a stored balance field.
    match /wallet/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.balance == 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Patient profiles ──────────────────────────────────────────────────────
    match /patient_profiles/{uid} {
      allow read:   if isOwner(uid) || isAdmin() || isDoctor();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // ── Notification counters (root-level per-user doc) ───────────────────────
    match /notifications/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // ── Reward history ────────────────────────────────────────────────────────
    // Same shape as /wallet above: seeded once at signup with totalPoints 0
    // and never updated by a client, so the points total is admin-only.
    match /reward_history/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.totalPoints == 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Login audit log ───────────────────────────────────────────────────────
    match /login_audit/{uid}/events/{eventId} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['success', 'method', 'timestamp', 'expiresAt']);
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Phone index (MPIN-first login detection) ─────────────────────────────
    // Publicly readable so the login screen can check whether a phone has MPIN
    // before sending OTP. Only stores {hasMpin: bool, uid: string} — no PII.
    match /phone_index/{phone} {
      allow read:   if true;           // pre-auth check on login screen
      // A caller may only ever point a phone entry at their OWN uid.
      // verifyMpinAndIssueToken (functions/index.js) resolves phone -> uid
      // from this index and mints a custom token for whatever uid it finds,
      // so an unconstrained write here is an auth-surface tampering vector
      // (targeting another account's uid, or locking it out via the
      // 5-attempt MPIN lockout). Both client writers already set uid to the
      // signed-in user (auth_provider.dart), so this is non-breaking.
      allow create, update: if isAuth() &&
                               request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // ── Prescription drafts (auto-save while doctor is writing) ─────────────
    // Each doctor owns exactly one draft document keyed by their UID.
    match /prescription_drafts/{doctorId} {
      allow read, write: if isOwner(doctorId) || isAdmin();
    }

    // ── App ratings (one-time user feedback after booking) ───────────────────
    match /app_ratings/{ratingId} {
      allow create: if isAuth();
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
