    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "agora-token": "^2.0.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.6.0",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
